# Turso Database Configuration
# Leave URL as file:spar_images.db for local SQLite development, or use your Turso remote URL
TURSO_DATABASE_URL=file:spar_images.db
TURSO_AUTH_TOKEN=

# Cloudinary Configuration
# Leave blank to store uploaded images in server/uploads/ locally
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT Secret & Server Port
JWT_SECRET=spar_product_library_secure_jwt_secret_key_2026_xyz
PORT=5005

# Default Admin Credentials for setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
