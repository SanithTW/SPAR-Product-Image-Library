{
  "name": "spar-product-image-library",
  "version": "1.0.0",
  "description": "SPAR Product Image Library - Search, preview, and download product images by DC code or name",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "start": "cd server && npm start",
    "build": "cd client && npm run build",
    "seed": "cd server && node createAdmin.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
