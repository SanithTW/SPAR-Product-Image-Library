{
  "name": "spar-product-image-library",
  "version": "1.0.0",
  "description": "SPAR Product Image Library - Search, preview, and download product images by DC code or name",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/index.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node server/createAdmin.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
